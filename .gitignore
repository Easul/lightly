# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Keystore files - never commit signing keys
*.jks
*.keystore
*.p12
key.properties

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/.gradle/
/android/.kotlin/
/android/captures/
/android/local.properties
/android/build/reports/
/android/build/reports/problems/
/android/build/reports/problems/problems-report.html

# Proxy core native libraries - generated build outputs, do not commit unless explicitly requested
/android/app/src/main/jniLibs/*/libproxy_core.so

# Private YouTube resolver source and generated embedded AAR
/extensions/youtube/
/android/app/libs/lightly-youtube-resolver.aar

# Rust build artifacts and caches - generated locally/CI only
/rust/proxy-core/target/

# Local scratch workspace
/temp/*
!/temp/.gitkeep
/tmp/

# Sisyphus agent session data
.sisyphus/

# Local agent / workspace metadata
/.omo/

# Common generated diagnostics
*.hprof
*.orig
*.rej

/.codex
/.agents
/.claude
/.opencode
